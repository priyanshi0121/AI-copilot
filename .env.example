# ============================================================
# AIOps Copilot configuration
# Copy to .env and fill in. Everything works WITHOUT any AI key
# (rule-based fallback) — add a key to activate AI reasoning.
# ============================================================

# --- AI provider: anthropic | zai | openai | ollama ---
AI_PROVIDER=anthropic

# Anthropic (Claude) — key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Z.ai (GLM) — key from https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6

# OpenAI — key from https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, free) — install from https://ollama.com, then: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# --- Detection thresholds ---
LATENCY_THRESHOLD_S=0.5
ERROR_RATE_THRESHOLD=0.3
CHECK_INTERVAL_S=10
RESOLVE_AFTER_CHECKS=2

# --- Correlation ---
DEPLOY_WINDOW_MIN=30

# --- Cost model (documented assumptions, tweak freely) ---
VCPU_HOUR_RATE=0.0446
CPU_PER_REPLICA=0.5
REPLICAS=1
BASELINE_LATENCY_S=0.2
AVG_ORDER_VALUE=42.0

# --- Prioritization ---
ENGINEER_WINDOW_MIN=60
