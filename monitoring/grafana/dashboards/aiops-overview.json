{
  "uid": "aiops-overview",
  "title": "AIOps — Services Overview",
  "tags": ["aiops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Average latency per service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(order_request_latency_seconds_sum[30s]) / rate(order_request_latency_seconds_count[30s])",
          "legendFormat": "order-service"
        },
        {
          "refId": "B",
          "expr": "rate(payment_request_latency_seconds_sum[30s]) / rate(payment_request_latency_seconds_count[30s])",
          "legendFormat": "payment-service"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(order_requests_total[30s]))",
          "legendFormat": "order-service"
        },
        {
          "refId": "B",
          "expr": "sum(rate(payment_requests_total[30s]))",
          "legendFormat": "payment-service"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (non-200 responses)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(order_requests_total{status!=\"200\"}[30s])) / sum(rate(order_requests_total[30s]))",
          "legendFormat": "order-service"
        },
        {
          "refId": "B",
          "expr": "sum(rate(payment_requests_total{status!=\"200\"}[30s])) / sum(rate(payment_requests_total[30s]))",
          "legendFormat": "payment-service"
        }
      ]
    },
    {
      "id": 4,
      "title": "Prometheus scrape health",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"order-service\"}", "legendFormat": "order-service" },
        { "refId": "B", "expr": "up{job=\"payment-service\"}", "legendFormat": "payment-service" }
      ]
    }
  ]
}
